---
/**
 * Hero — name + bio_short + contact links + portrait.
 *
 * - Name uses gradient text via .gradient-text utility (background-clip: text).
 * - Portrait subtly scales 1.02 on hover (respects reduced motion).
 * - Contact links wrap on mobile; separators are dot bullets with text.muted color.
 */
import Mail from './icons/Mail.astro';
import Scholar from './icons/Scholar.astro';
import GitHub from './icons/GitHub.astro';
import LinkedIn from './icons/LinkedIn.astro';

interface ContactLink {
  href: string;
  label: string;
  icon: 'mail' | 'scholar' | 'github' | 'linkedin';
}

export interface Props {
  name: string;
  portraitSrc: string;
  portraitAlt: string;
  contacts: ContactLink[];
}

const {
  name,
  portraitSrc,
  portraitAlt,
  contacts,
} = Astro.props;
---

<section class="research-hero pt-16 pb-14 md:pt-24 md:pb-20">
  <div class="mx-auto max-w-content px-5 sm:px-6 lg:px-8">
    <div class="intro-card enter-rise border border-subtle bg-bg-overlay p-5 shadow-card md:p-7">
      <div class="grid gap-6 md:grid-cols-[8rem_minmax(0,1fr)] md:items-center md:gap-8">
        <div class="portrait-wrap">
          <img
            src={portraitSrc}
            alt={portraitAlt}
            width="128"
            height="128"
            loading="eager"
            decoding="async"
            class="hero-portrait h-28 w-28 rounded-[1.25rem] object-cover shadow-card md:h-32 md:w-32"
          />
          <p class="mt-3 text-center font-bold leading-tight text-primary">
            {name}
          </p>
        </div>

        <div class="min-w-0">
          <p class="max-w-prose text-body font-medium leading-relaxed text-secondary">
            Hi all, I am an integrated M.S./Ph.D. student at UNIST, advised by Prof. Jaejun Yoo. My research interests include multimodal data generation models across video, audio, and text, as well as building robust dataset benchmarks.
          </p>
          {
            contacts.length > 0 && (
              <nav
                class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-small text-secondary"
                aria-label="Contact"
              >
                {contacts.map((link) => (
                  <>
                    <a
                      href={link.href}
                      class="inline-flex items-center gap-1.5 font-medium hover:text-accent-hover hover:underline underline-offset-[3px] decoration-1 transition-colors duration-fast ease-standard"
                      {...(link.href.startsWith('http')
                        ? { target: '_blank', rel: 'noopener noreferrer' }
                        : {})}
                    >
                      {link.icon === 'mail' && <Mail />}
                      {link.icon === 'scholar' && <Scholar />}
                      {link.icon === 'github' && <GitHub />}
                      {link.icon === 'linkedin' && <LinkedIn />}
                      <span>{link.label}</span>
                    </a>
                  </>
                ))}
              </nav>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .research-hero {
    position: relative;
    isolation: isolate;
  }

  .portrait-wrap p {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
  }

  .intro-card {
    position: relative;
    z-index: 1;
    overflow: hidden;
    border-radius: 1.25rem;
    backdrop-filter: blur(18px);
    --entry-delay: 40ms;
  }

  .portrait-wrap {
    position: relative;
    width: max-content;
  }

</style>
