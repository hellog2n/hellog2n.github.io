@inproceedings{jang2025bright,
  abbr        = {BMVC},
  bibtex_show = {true},
  selected    = {true},
  title       = {B-RIGHT: Benchmark Re-evaluation for Integrity in Generalized Human-Object Interaction Testing},
  author      = {Jang*, Yoojin and Kim*, Junsu and Kim, Hayeon and Lee, Eun-ki and Kim, Eun-sol and Baek, Seungryul and Yoo, Jaejun},
  booktitle   = bmvc,
  year        = {2025},
  html        = {https://bmvc2025.bmva.org/proceedings/272/},
  code        = {https://github.com/hellog2n/B-RIGHT},
  preview     = {bright.png},
  abstract    = {HICO-DET mixes severe class imbalance with uneven train/test counts, so HOI scores quietly inflate or deflate. B-RIGHT balances every class through automated generation-and-filtering and adds a zero-shot split — re-evaluation cuts variance and shifts rankings.},
  annotation  = {* Equal contribution.}
}

@inproceedings{yeo2024nickel,
  abbr        = {ECCV},
  bibtex_show = {true},
  selected    = {true},
  title       = {Nickel and Diming Your GAN: A Dual-Method Approach to Enhancing GAN Efficiency via Knowledge Distillation},
  author      = {Yeo, Sangyeop and Jang, Yoojin and Yoo, Jaejun},
  booktitle   = eccv,
  year        = {2024},
  arxiv       = {2405.11614},
  code        = {https://github.com/SangyeopYeo/NICKEL_AND_DIME},
  html        = {https://sangyeopyeo.github.io/Nickel_and_Diming_Your_GAN/},
  preview     = {nickel_dime.png},
  abstract    = {DiME distills GANs by matching distributions in foundation-model embeddings via MMD; NICKEL keeps the student generator and discriminator talking through interactive compression. Together they reach FID 10.45 at 95.73% compression on FFHQ and still hold up at 99.69%.}
}

@article{kim2023toppr,
  abbr        = {NeurIPS},
  bibtex_show = {true},
  selected    = {true},
  title       = {TopP\&R: Robust Support Estimation Approach for Evaluating Fidelity and Diversity in Generative Models},
  author      = {Kim, Pum Jun and Jang, Yoojin and Kim, Jisu and Yoo, Jaejun},
  journal     = neurips,
  year        = {2023},
  arxiv       = {2306.08013},
  code        = {https://github.com/LAIT-CVLab/TopPR},
  html        = {https://lait-cvlab.github.io/TopPR/},
  preview     = {toppr.png},
  abstract    = {FID, IS, and precision-recall all rest on supports estimated from sample features, but nobody checks whether those supports are reliable. TopP\&R keeps only topologically and statistically significant features, giving fidelity and diversity scores stable under outliers and non-IID noise.}
}

@inproceedings{yeo2023slt,
  abbr        = {AAAI},
  bibtex_show = {true},
  selected    = {true},
  title       = {Can We Find Strong Lottery Tickets in Generative Models?},
  author      = {Yeo, Sangyeop and Jang, Yoojin and Sohn, Jy-yong and Han, Dongyoon and Yoo, Jaejun},
  booktitle   = aaai,
  year        = {2023},
  html        = {https://ojs.aaai.org/index.php/AAAI/article/view/25433},
  code        = {https://github.com/SangyeopYeo/Edge-popup_with_MMD},
  preview     = {canwe.png},
  award       = {Oral Presentation},
  award_name  = {Oral},
  abstract    = {Strong lottery tickets ask whether a random network already contains a working subnetwork, no weight updates allowed. We bring this to generators: only a binary mask is learned over an untrained model, guided by moment-matching scores (MMD). With 10% of weights left, it matches the dense baseline.}
}

